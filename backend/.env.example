# ─────────────────────────────────────────────────────────────────────────────
# RAG Agent — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=20

# ── RAG retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_HISTORY_PAIRS=5

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres           # 'postgres' inside Docker, 'localhost' for local dev
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant               # 'qdrant' inside Docker, 'localhost' for local dev
QDRANT_PORT=6333
QDRANT_API_KEY=                  # leave blank for self-hosted; required for Qdrant Cloud
QDRANT_COLLECTION=documents

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGINS=["*"]

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
